RewriteEngine On

# 1. Protect the SQLite Database from being downloaded
<FilesMatch "\.(db|sqlite|sqlite3)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 2. Serve React assets directly from frontend/dist if they exist (for performance)
RewriteCond %{DOCUMENT_ROOT}/frontend/dist%{REQUEST_URI} -f
RewriteRule ^(.*)$ frontend/dist/$1 [L]

# 3. Route API requests
RewriteRule ^api/(.*)$ api/api.php [QSA,L]

# 4. Route Report requests
RewriteRule ^reports/(.*)$ api/reports_api.php [QSA,L]

# 5. Route all other requests to index.php (React SPA Router handles the rest)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
