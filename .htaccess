RewriteEngine On

# Enable GZIP / Deflate Compression for Low-Speed Networks
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Browser Caching for Static Assets (templates use versioning ?v=... for cache busting)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# 1. Protect sensitive files, dotfiles, and databases from public access
<FilesMatch "^\.env|\.git|\.(db|sqlite|sqlite3|sql|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 2. Route API requests
RewriteRule ^api/(.*)$ api/api.php [QSA,L]

# 3. Route Report requests
RewriteRule ^reports/(.*)$ api/reports_api.php [QSA,L]

# 4. Route all other requests to index.php (so /login, /receptionist work properly)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
